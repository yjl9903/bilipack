{
  "name": "@bilipack/monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "release": "bumpp package.json packages/*/package.json apps/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bumpp": "latest",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=v24.0.0"
  }
}
